.worktrees/

# Ethos mission log
.ethos/

# Vendored ethos runtime state (regenerated per-machine — vendored registry only)
.punt-labs/ethos/missions/
.punt-labs/ethos/missions.jsonl
.punt-labs/ethos/sessions/
.punt-labs/ethos/.biff

# Vox tool local data
.vox/

# Punt Labs toolchain ignores
.punt-labs/quarry/captures/*.md
.punt-labs/local/
*.ini
uv.toml

# Spike/scratch/demo trees — release tooling requires a clean working tree
# (CLAUDE.md gotcha from v0.5.0: punt release fails if demos/ is dirty)
spikes/*
!spikes/io_model_v1/
demos/

# Sibling lock files. Two sources: bd's transient .create.lock, and the lock
# every punt CLI takes before mutating a shared host file (tool-enable-disable.md
# 2.4), which persists by design because unlinking it races the next writer. The
# pattern is broad because a punt lock is named after its host file and tools
# differ on the suffix — .CLAUDE.md.lock and .settings.json.punt-import.lock
# both occur.
.*.lock

# Per-user plugin local config (vox/biff/etc.) — never tracked
*.local.md

# LaTeX build artifacts for root prfaq.tex (PDF is committed for the README badge link)
/prfaq.aux
/prfaq.bbl
/prfaq.bcf
/prfaq.blg
/prfaq.log
/prfaq.out
/prfaq.run.xml
/prfaq.toc
