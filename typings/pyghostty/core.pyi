from collections.abc import Callable
from typing import Literal, NamedTuple, overload

from . import _ffi
from ._ffi import (
    CData,
    GhosttyGridRefPointer,
    GhosttySelectionPointer,
    GhosttyTerminalImpl,
    Pointer,
)

class UnknownSequence(NamedTuple):
    kind: str
    content: bytes
    truncated: bool
    terminator: str | None

class Terminal:
    _t: Pointer[Pointer[GhosttyTerminalImpl]]
    _free: Callable[[], None]
    _unknown_cb: CData | None
    _reply_cb: CData | None
    _cb_err: BaseException | None
    def __init__(
        self,
        cols: int = ...,
        rows: int = ...,
        scrollback: int = ...,
        fg: tuple[int, int, int] | None = ...,
        bg: tuple[int, int, int] | None = ...,
    ) -> None: ...
    def feed(self, data: bytes | str) -> None: ...
    def feed_until_ground(self, data: bytes | str) -> int | None: ...
    def on_reply(self, fn: Callable[[bytes], None] | None) -> None: ...
    def on_unknown_sequence(
        self, fn: Callable[[UnknownSequence], None] | None, max_bytes: int = ...
    ) -> None: ...
    def get(self, key: str, ctype: str = ...) -> int: ...
    def mode(self, n: int, ansi: bool = ...) -> bool: ...
    @property
    def size(self) -> tuple[int, int]: ...
    @property
    def cursor(self) -> tuple[int, int]: ...
    def ref(self, x: int, y: int, tag: str = ...) -> GhosttyGridRefPointer: ...
    def _format_sel(self, sel: GhosttySelectionPointer, unwrap: bool = ...) -> str: ...
    def text(self) -> str: ...
    def contents(self) -> str: ...
    def resize(
        self, cols: int, rows: int, cell_width_px: int = ..., cell_height_px: int = ...
    ) -> None: ...
    def close(self) -> None: ...
    def style(self, x: int, y: int, tag: str = ...) -> dict[str, object]: ...

@overload
def init_sized(
    ctype: Literal["GhosttyFormatterTerminalOptions"],
) -> _ffi.GhosttyFormatterTerminalOptionsPointer: ...
@overload
def init_sized(
    ctype: Literal["GhosttyMouseEncoderSize"],
) -> _ffi.GhosttyMouseEncoderSizePointer: ...
@overload
def init_sized(
    ctype: Literal["GhosttyRenderStateColors"],
) -> _ffi.GhosttyRenderStateColorsPointer: ...
@overload
def init_sized(
    ctype: Literal["GhosttyRenderStateCursor"],
) -> _ffi.GhosttyRenderStateCursorPointer: ...
@overload
def init_sized(
    ctype: Literal["GhosttyRenderStateRowSelection"],
) -> _ffi.GhosttyRenderStateRowSelectionPointer: ...
@overload
def init_sized(ctype: Literal["GhosttySelection"]) -> GhosttySelectionPointer: ...
@overload
def init_sized(ctype: Literal["GhosttyStyle"]) -> _ffi.GhosttyStylePointer: ...
@overload
def init_sized(
    ctype: Literal["GhosttyTerminalSelectLineOptions"],
) -> _ffi.GhosttyTerminalSelectLineOptionsPointer: ...
@overload
def init_sized(
    ctype: Literal["GhosttyTerminalSelectWordOptions"],
) -> _ffi.GhosttyTerminalSelectWordOptionsPointer: ...
@overload
def init_sized(
    ctype: Literal["GhosttyTerminalSelectionFormatOptions"],
) -> _ffi.GhosttyTerminalSelectionFormatOptionsPointer: ...
